aws_region            = "us-east-1"
availability_zone     = "us-east-1a"
ssh_key_name          = "my-linux-key"
windows_key_name      = "my-windows-key"
attacker_ami          = "ami-0123456789abcdef0"
dvwa_ami              = "ami-0fedcba9876543210"
windows_ami           = "ami-0a1b2c3d4e5f67890"
siem_ami              = "ami-05555555555555555"
attacker_instance_type = "t3.small"
dvwa_instance_type     = "t3.small"
windows_instance_type  = "t3.large"
siem_instance_type     = "t3.medium"
enable_siem            = true
